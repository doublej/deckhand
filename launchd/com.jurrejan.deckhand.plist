<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jurrejan.deckhand</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>deckhand-daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jurrejan/dev/multi-stack/deckhand/daemon</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jurrejan/Library/Logs/Deckhand/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jurrejan/Library/Logs/Deckhand/launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jurrejan</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/jurrejan/.local/bin:/Users/jurrejan/.bun/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- Not Background: that throttles CPU and I/O, and the iTerm lookup then blows its
         timeout. This job answers a phone; it should be scheduled like it. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
